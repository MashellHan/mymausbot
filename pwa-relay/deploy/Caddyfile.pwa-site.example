# Optional site block for serving the static PWA bundle (`dist/`) directly from Caddy
# alongside `pwa-relay` (for example, when bypassing proxied CDN Anycast on cellular networks).
# Mount the built `dist/` directory read-only at `/srv/pwa` in `compose.yaml` and replace
# `mausbot.mxhan.com` / `https://relay.mxhan.com` with your own origins before appending to `Caddyfile`.
# Note: `Caddyfile` sets `admin off`, so apply edits with `docker compose restart caddy` after
# `docker compose exec -T caddy caddy validate --config /etc/caddy/Caddyfile </dev/null`.

mausbot.mxhan.com {
	header -Server
	encode zstd gzip
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://relay.mxhan.com; media-src 'self' blob: https://relay.mxhan.com; font-src 'self' data:; connect-src 'self' https://relay.mxhan.com wss://relay.mxhan.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer"
	header X-Frame-Options "DENY"
	header Permissions-Policy "camera=(), microphone=(self), geolocation=()"

	root * /srv/pwa

	@noCache path / /index.html /sw.js
	header @noCache Cache-Control "no-cache"

	@manifest path /manifest.webmanifest
	header @manifest Cache-Control "public, max-age=3600"

	@existingAsset {
		path /assets/*
		file {
			try_files {path}
		}
	}
	handle @existingAsset {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Missing /assets/* paths fall back to text/html so omb-pwa-shell-v4 detects pruned chunks and self-heals.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
